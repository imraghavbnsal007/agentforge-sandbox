# Agent behavior: "mock" (deterministic agent, no API calls) or "llm" (Claude API)
AGENT_MODE=mock

# Required when AGENT_MODE=llm
ANTHROPIC_API_KEY=

# Claude model used by the llm runner
ANTHROPIC_MODEL=claude-opus-4-8

# The values below are only needed when running the backend OUTSIDE Docker.
# Inside Docker Compose they are set per-service in docker-compose.yml.
# DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge
# REDIS_URL=redis://localhost:6379/0
