# Agent behavior: "mock" (deterministic agent, no API calls) or "llm"
AGENT_MODE=mock

# --- LLM providers -----------------------------------------------------
# Default provider and model when no profile/override applies.
# Providers: anthropic | google | openai | openrouter | ollama
LLM_PROVIDER=anthropic
DEFAULT_MODEL=

# Provider credentials (only the ones you use)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=

# Execution profile building blocks (override to change what each profile uses)
# PROFILE_CHEAP_PROVIDER=google
# PROFILE_CHEAP_MODEL=gemini-2.5-flash
# PROFILE_BALANCED_PROVIDER=anthropic
# PROFILE_BALANCED_MODEL=claude-sonnet-5
# PROFILE_PREMIUM_PROVIDER=anthropic
# PROFILE_PREMIUM_MODEL=claude-opus-4-8

# GitHub PR workflow (optional). Fine-grained PAT with Contents and
# Pull requests read/write on the target repo.
GITHUB_TOKEN=

# Optional safety allowlist: only these repos may receive PRs,
# e.g. "you/agentforge-sandbox,you/other-repo"
GITHUB_ALLOWED_REPOS=

# The values below are only needed when running the backend OUTSIDE Docker.
# Inside Docker Compose they are set per-service in docker-compose.yml.
# DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge
# REDIS_URL=redis://localhost:6379/0
