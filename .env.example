# Agent behavior: "mock" (deterministic agent, no API calls) or "llm"
AGENT_MODE=mock

# --- LLM providers -----------------------------------------------------
# Default provider and model when no profile/override applies.
# Providers: anthropic | google | openai | openrouter | ollama
LLM_PROVIDER=anthropic
DEFAULT_MODEL=

# Provider credentials (only the ones you use)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=

# Execution profile building blocks (override to change what each profile uses)
# PROFILE_CHEAP_PROVIDER=google
# PROFILE_CHEAP_MODEL=gemini-3.5-flash
# PROFILE_BALANCED_PROVIDER=anthropic
# PROFILE_BALANCED_MODEL=claude-sonnet-5
# PROFILE_PREMIUM_PROVIDER=anthropic
# PROFILE_PREMIUM_MODEL=claude-opus-4-8

# GitHub PR workflow (optional). Fine-grained PAT with Contents and
# Pull requests read/write on the target repo.
GITHUB_TOKEN=

# Optional safety allowlist: only these repos may receive PRs,
# e.g. "you/agentforge-sandbox,you/other-repo"
GITHUB_ALLOWED_REPOS=

# --- Authentication ----------------------------------------------------
# local      = single-user development. No sign-in; every request runs as the
#              default local user and repo access uses GITHUB_TOKEN above.
#              This is the default and preserves the original workflow.
# github_app = public multi-user. GitHub sign-in required; unauthenticated
#              callers get 401.
AUTH_MODE=local

# Only needed when AUTH_MODE=github_app. From your GitHub App's settings page.
# These identify the *user*; they are never used to clone, push, or open PRs.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The App's URL slug, e.g. "agentforge-dev" for github.com/apps/agentforge-dev
GITHUB_APP_NAME=

# Repository access. The numeric App ID and the RSA private key are used to
# mint short-lived *installation* tokens — the only credential that ever
# touches a repository. Never commit the key: mount it as a secret in
# production, keep a gitignored copy locally (*.pem is ignored).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/agentforge-app.pem

# Commit identity for pull requests opened through the GitHub App. BOTH are
# required in github_app mode and have no default on purpose — inventing a
# noreply address would attribute commits to an identity that may not exist.
# Use the App's bot identity, e.g.
#   GITHUB_APP_COMMIT_NAME=agentforge[bot]
#   GITHUB_APP_COMMIT_EMAIL=<bot-user-id>+agentforge[bot]@users.noreply.github.com
GITHUB_APP_COMMIT_NAME=
GITHUB_APP_COMMIT_EMAIL=

# Webhook shared secret, from the GitHub App's webhook settings. Without it
# the webhook endpoint refuses every delivery rather than trusting payloads
# it cannot verify. Webhooks need a public HTTPS URL, so local development
# requires a tunnel:
#   Webhook URL: https://<tunnel-host>/api/v1/github/webhooks
GITHUB_APP_WEBHOOK_SECRET=

# Must match the "Callback URL" configured on the GitHub App exactly.
GITHUB_APP_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
# Where the backend sends the browser once a session exists.
FRONTEND_URL=http://localhost:3000

# Browser origins allowed to send credentialed requests (comma-separated).
# A wildcard is rejected at startup — it cannot be combined with cookies.
CORS_ORIGINS=http://localhost:3000

# Secure cookies require HTTPS. Leave false for local http:// development;
# set true in production.
COOKIE_SECURE=false
# Trust X-Forwarded-For for client IPs. Enable only behind a reverse proxy
# that overwrites the header, otherwise callers can spoof it past rate limits.
TRUST_PROXY_HEADERS=false

# The values below are only needed when running the backend OUTSIDE Docker.
# Inside Docker Compose they are set per-service in docker-compose.yml.
# DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge
# REDIS_URL=redis://localhost:6379/0
