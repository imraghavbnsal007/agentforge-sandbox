# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node
node_modules/
.next/

# Env
.env

# OS
.DS_Store

# Database backups (keep the directory, never commit dumps)
backups/*.sql

# GitHub App private keys — never commit. Mount as a secret in production;
# keep a local copy here during development.
*.pem
secrets/*
!secrets/.gitkeep

# Backups written by scripts/setup_github_app.sh — these contain the App
# client secret and webhook secret, so they must never be committed.
.env.backup-*
